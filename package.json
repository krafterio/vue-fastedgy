{
    "name": "vue-fastedgy",
    "version": "1.0.1",
    "description": "Package to facilitate integration between a FastEdgy server and a Vue.js application",
    "type": "module",
    "main": "./index.js",
    "peerDependencies": {
        "pinia": "^2.1.7 || ^3.0.0 || ^4.0.0",
        "vue": "^3.4.15",
        "vue-i18n": "^11.1.12",
        "vue-router": "^4.2.5 || ^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.5.2",
        "typescript": "^5.9.2",
        "@vue/test-utils": "^2.4.4",
        "jsdom": "^24.0.0",
        "vitest": "^3.1.2"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "import": "./index.js",
            "types": "./types/index.d.ts"
        }
    },
    "allowScripts": {
        "esbuild": false,
        "fsevents": false
    }
}
